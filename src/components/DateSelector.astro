---
/**
 * DateSelector — cascading Year / Month picker that navigates to the
 * correct paginated page and scrolls to the month group anchor.
 * Also includes a themed tag picker with search + top tags.
 *
 * Props:
 *   dateIndex – JSON-serialisable map: { "2026-02": 1, "2026-01": 2, … }
 *   baseUrl   – e.g. "/blog"
 */

import '../styles/picker-dropdown.css';

interface Props {
  dateIndex: Record<string, number>;
  /** Releases per month, keyed "YYYY-MM". */
  monthCounts: Record<string, number>;
  baseUrl: string;
  currentYear?: number;
  currentMonth?: number;
}

const { dateIndex, monthCounts, baseUrl, currentYear, currentMonth } = Astro.props;

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<div
  class="date-selector"
  data-base={base}
  data-current-year={currentYear ?? ''}
  data-current-month={currentMonth ?? ''}
  data-blog-url={baseUrl}
  data-date-index={JSON.stringify(dateIndex)}
  data-month-counts={JSON.stringify(monthCounts)}
>
  <div class="ds-picker">
    <button
      class="header-control-btn"
      type="button"
      data-ds-date-btn
      aria-expanded="false"
      aria-haspopup="listbox"
    >
      <span>#date</span>
      <span class="header-control-arrow" data-ds-date-arrow>▾</span>
    </button>
  </div>

  <span class="ds-sep">│</span>

  <div class="ds-picker">
    <button
      class="header-control-btn"
      type="button"
      data-ds-tag-btn
      aria-expanded="false"
      aria-haspopup="listbox"
    >
      <span>#tag</span>
      <span class="header-control-arrow" data-ds-tag-arrow>
        ▾
      </span>
    </button>
  </div>

  <slot />
</div>


<script>
  import {
    createPickerCrumbs,
    createPickerFooter,
    createPickerPanel,
    createPickerPanelDom,
    createPickerRow,
    loadJsonCached,
    type PickerCrumbs,
  } from '../lib/picker-panel';
  import { navigateInternal } from '../lib/navigate';
  import { getCurrentSiteLang, getSiteCopy } from '../lib/site-i18n.mjs';
  import { encodeTagParam } from '../lib/tag-path';

  interface TagSummary {
    name: string;
    count: number;
  }

  interface DateSelectorRoot extends HTMLElement {
    __tagPickerBound?: boolean;
    __tagDropdown?: HTMLElement | null;
    __dateBound?: boolean;
    __datePanel?: HTMLElement | null;
    /** Refresh chrome and rows after the language changes. */
    __refreshDatePanel?: () => void;
  }

  type DateSelectorWindow = Window & {
    __dateSelectorTagPageLoadBound?: boolean;
  };

  const INITIAL_SHOW = 10;
  const tagDataCache = new Map<string, Promise<TagSummary[]>>();

  function getBase(root: HTMLElement): string {
    return root.dataset.base || '/';
  }

  function loadTags(base: string) {
    return loadJsonCached(tagDataCache, `${base}api/tags.json`);
  }

  function ensureDropdown(root: DateSelectorRoot, tags: TagSummary[], closeDropdown: () => void) {
    if (root.__tagDropdown?.isConnected) {
      return root.__tagDropdown;
    }

    const { panel: dropdown, searchInput, listEl } = createPickerPanelDom('search tags…');

    const moreBtn = createPickerFooter(
      `${getBase(root)}tags/`,
      `all ${tags.length} tags →`,
      closeDropdown,
    );
    dropdown.appendChild(moreBtn);

    function renderTags(filter: string) {
      listEl.innerHTML = '';
      const query = filter.toLowerCase().trim();
      let items = tags;

      if (query) {
        items = tags.filter((tag) => tag.name.toLowerCase().includes(query));
        moreBtn.hidden = true;
      } else {
        items = tags.slice(0, INITIAL_SHOW);
        moreBtn.hidden = false;
      }

      if (items.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'picker-empty';
        empty.textContent = 'no matching tags';
        listEl.appendChild(empty);
        return;
      }

      for (const tag of items) {
        const link = createPickerRow({
          href: `${getBase(root)}tags/${encodeTagParam(tag.name)}`,
          name: `#${tag.name}`,
          count: tag.count,
        });

        link.addEventListener('click', (event) => {
          event.preventDefault();
          closeDropdown();
          navigateInternal(link.href);
        });

        listEl.appendChild(link);
      }
    }

    searchInput.addEventListener('input', () => {
      renderTags(searchInput.value);
    });

    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        const first = listEl.querySelector('.picker-item') as HTMLAnchorElement | null;
        if (first) {
          closeDropdown();
          navigateInternal(first.href);
        }
      }
    });

    renderTags('');
    root.__tagDropdown = dropdown;
    return dropdown;
  }

  function bindTagPicker(root: DateSelectorRoot) {
    if (root.__tagPickerBound) {
      return;
    }
    root.__tagPickerBound = true;

    const button = root.querySelector<HTMLButtonElement>('[data-ds-tag-btn]');
    const arrow = root.querySelector<HTMLElement>('[data-ds-tag-arrow]');
    if (!button || !arrow) {
      return;
    }

    const floatingTagDropdown = createPickerPanel({
      button,
      arrow,
      getPanel: () => root.__tagDropdown ?? null,
    });

    button.addEventListener('click', async (event) => {
      event.stopPropagation();
      const tags = await loadTags(getBase(root));
      ensureDropdown(root, tags, () => floatingTagDropdown.close());
      floatingTagDropdown.toggle();
    });
  }

  /** One formatter per language: building one is ~100x the cost of a format. */
  const monthFormatters = new Map<string, Intl.DateTimeFormat>();

  function monthFormatter(lang: string): Intl.DateTimeFormat {
    let formatter = monthFormatters.get(lang);
    if (!formatter) {
      formatter = new Intl.DateTimeFormat(lang, { month: 'short', timeZone: 'UTC' });
      monthFormatters.set(lang, formatter);
    }
    return formatter;
  }

  /** Short month name in the site language, capitalised ("янв." / "Jan"). */
  function monthLabel(month: number): string {
    const date = new Date(Date.UTC(2021, month - 1, 1));
    const label = monthFormatter(getCurrentSiteLang()).format(date);
    return label.charAt(0).toUpperCase() + label.slice(1);
  }

  /** Month rows of one year, newest first: [monthNumber, releases]. */
  function monthsOfYear(counts: Record<string, number>, year: number): Array<[number, number]> {
    return Object.entries(counts)
      .map(([key, count]) => {
        const [keyYear, month] = key.split('-').map(Number);
        return keyYear === year ? ([month, count] as [number, number]) : null;
      })
      .filter((entry): entry is [number, number] => entry !== null)
      .sort((a, b) => b[0] - a[0]);
  }

  function bindDatePicker(root: DateSelectorRoot) {
    if (root.__dateBound) return;
    root.__dateBound = true;

    const button = root.querySelector<HTMLButtonElement>('[data-ds-date-btn]');
    const arrow = root.querySelector<HTMLElement>('[data-ds-date-arrow]');
    if (!button || !arrow) return;

    const index = JSON.parse(root.dataset.dateIndex || '{}') as Record<string, number>;
    const counts = JSON.parse(root.dataset.monthCounts || '{}') as Record<string, number>;
    const blogUrl = root.dataset.blogUrl || '/blog';
    const years = [...new Set(Object.keys(counts).map((key) => Number(key.split('-')[0])))].sort(
      (a, b) => b - a,
    );
    const startYear = Number(root.dataset.currentYear || 0);

    /** '' = all years, otherwise the drilled year. */
    let year: number | null = years.includes(startYear) ? startYear : null;

    const dropdown = createPickerPanel({
      button,
      arrow,
      getPanel: () => root.__datePanel ?? null,
    });

    function ensurePanel() {
      if (root.__datePanel?.isConnected) return root.__datePanel;

      const copy = getSiteCopy('datePicker', getCurrentSiteLang());
      const { panel, listEl } = createPickerPanelDom('', false);
      const crumbs = createPickerCrumbs(
        () => getSiteCopy('datePicker', getCurrentSiteLang()).rootLabel,
        () => {
          year = null;
          render(panel, listEl, crumbs);
        },
      );
      panel.insertBefore(crumbs.el, listEl);
      const footer = createPickerFooter(blogUrl, copy.footer, () => dropdown.close());
      panel.appendChild(footer);
      render(panel, listEl, crumbs);
      root.__datePanel = panel;
      root.__refreshDatePanel = () => {
        footer.textContent = getSiteCopy('datePicker', getCurrentSiteLang()).footer;
        if (!panel.hidden) render(panel, listEl, crumbs);
      };
      return panel;
    }

    function monthHref(key: string): string {
      const page = index[key];
      if (page == null) return blogUrl;
      return page === 1 ? `${blogUrl}#month-${key}` : `${blogUrl}/${page}#month-${key}`;
    }

    function render(panel: HTMLElement, listEl: HTMLElement, crumbs: PickerCrumbs) {
      crumbs.setTrail(year === null ? [] : [String(year)]);
      listEl.innerHTML = '';

      if (year === null) {
        for (const value of years) {
          const months = monthsOfYear(counts, value);
          const releases = months.reduce((sum, [, count]) => sum + count, 0);
          const row = createPickerRow({
            href: blogUrl,
            name: String(value),
            count: releases,
            drill: true,
          });
          row.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            year = value;
            render(panel, listEl, crumbs);
          });
          listEl.appendChild(row);
        }
        if (!years.length) listEl.appendChild(emptyRow('no reviews yet'));
        return;
      }

      const months = monthsOfYear(counts, year);
      for (const [month, count] of months) {
        const key = `${year}-${String(month).padStart(2, '0')}`;
        const row = createPickerRow({
          href: monthHref(key),
          name: monthLabel(month),
          count,
        });
        row.addEventListener('click', (event) => {
          event.preventDefault();
          dropdown.close();
          navigateInternal(monthHref(key));
        });
        listEl.appendChild(row);
      }
      if (!months.length) listEl.appendChild(emptyRow('no reviews yet'));
    }

    function emptyRow(text: string): HTMLElement {
      const empty = document.createElement('div');
      empty.className = 'picker-empty';
      empty.textContent = text;
      return empty;
    }

    button.addEventListener('click', (event) => {
      event.stopPropagation();
      ensurePanel();
      dropdown.toggle();
    });

    window.addEventListener('lang-changed', () => {
      root.__refreshDatePanel?.();
    });
  }

  function initDatePickers() {
    document.querySelectorAll<DateSelectorRoot>('.date-selector').forEach(bindDatePicker);
  }

  function initTagPickers() {
    document.querySelectorAll<DateSelectorRoot>('.date-selector').forEach(bindTagPicker);
  }

  if (!(window as DateSelectorWindow).__dateSelectorTagPageLoadBound) {
    (window as DateSelectorWindow).__dateSelectorTagPageLoadBound = true;
    document.addEventListener('astro:page-load', () => {
      initDatePickers();
      initTagPickers();
    });
  }
  initDatePickers();
  initTagPickers();
</script>

<style>
  .date-selector {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .ds-sep {
    color: var(--theme-border);
  }
  .ds-picker {
    position: relative;
  }

  @media (max-width: 640px) {
    .ds-sep {
      display: none;
    }
  }
</style>

