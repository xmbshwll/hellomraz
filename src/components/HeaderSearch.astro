---
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

<div id="header-search" class="header-search" data-base={base}>
  <form class="header-search-form" role="search" autocomplete="off">
    <label class="header-search-sr-only" for="header-search-input">
      Search artist or album
    </label>
    <div class="header-search-field">
      <span class="header-search-icon" aria-hidden="true">⌕</span>
      <input
        id="header-search-input"
        class="header-search-input"
        type="search"
        placeholder="search artist / album"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <button
        id="header-search-clear"
        class="header-search-clear"
        type="button"
        aria-label="Clear search"
        hidden
      >
        ✕
      </button>
    </div>
  </form>

  <button
    id="header-search-random"
    class="header-control-btn header-search-random"
    type="button"
    aria-label="Random album"
    title="Random album"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      viewBox="0 0 24 24"
      fill="currentColor"
      stroke="none"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <!-- Angled die, drawn first so the upright one overlaps it. -->
      <g transform="rotate(-18 15.3 8.8)">
        <rect x="9.3" y="2.8" width="12" height="12" rx="2.7"></rect>
        <g class="dice-pip">
          <circle cx="12.4" cy="5.9" r="1.3"></circle>
          <circle cx="18.2" cy="11.7" r="1.3"></circle>
        </g>
      </g>
      <!-- Upright die in front; its stroke carves the gap that separates the two. -->
      <rect class="dice-front" x="1.8" y="9.7" width="12.5" height="12.5" rx="2.8"></rect>
      <g class="dice-pip">
        <circle cx="5" cy="12.9" r="1.3"></circle>
        <circle cx="8.05" cy="15.95" r="1.3"></circle>
        <circle cx="11.1" cy="19" r="1.3"></circle>
      </g>
    </svg>
  </button>

  <div id="header-search-results" class="header-search-results" hidden></div>
</div>

<script>
  import { createFloatingDropdown } from "../lib/floating-dropdown.mjs";
  import {
    getPostSlugFromPath,
    getSearchResultPrimaryLabel,
    getSearchResultSecondaryLabel,
    pickRandomEntry,
    prepareSearchEntries,
    searchEntries,
  } from "../lib/search.mjs";

  interface SearchRawEntry {
    slug: string;
    title: string;
    artist?: string;
    album?: string;
  }

  interface PreparedSearchEntry extends SearchRawEntry {
    order: number;
    titleSearch: string;
    artistSearch: string;
    albumSearch: string;
    searchText: string;
  }

  const SEARCH_INPUT_DEBOUNCE_MS = 120;

  let cachedBase = "";
  let cachedEntries: PreparedSearchEntry[] | null = null;
  let loadingPromise: Promise<PreparedSearchEntry[]> | null = null;

  function navigateInternal(url: string) {
    const navigate = (window as Window & {
      __hellomrazNavigate?: (href: string) => Promise<void> | void;
    }).__hellomrazNavigate;

    if (typeof navigate === "function") {
      void navigate(url);
      return;
    }

    window.location.assign(url);
  }

  async function loadSearchIndex(base: string): Promise<PreparedSearchEntry[]> {
    if (cachedEntries && cachedBase === base) return cachedEntries;

    if (!loadingPromise || cachedBase !== base) {
      cachedBase = base;
      loadingPromise = fetch(`${base}api/search.json`)
        .then(async (response) => {
          if (!response.ok) {
            throw new Error("Failed to load search index");
          }
          const raw = (await response.json()) as SearchRawEntry[];
          cachedEntries = prepareSearchEntries(raw) as PreparedSearchEntry[];
          return cachedEntries;
        })
        .catch(() => {
          cachedEntries = [];
          return [];
        });
    }

    return loadingPromise;
  }

  function renderMessage(
    resultsEl: HTMLElement,
    message: string,
    kind = "info",
  ) {
    resultsEl.innerHTML = "";

    const empty = document.createElement("div");
    empty.className = `header-search-message ${kind === "loading" ? "is-loading" : ""}`;
    empty.textContent = message;
    resultsEl.appendChild(empty);
  }

  function renderResults(
    resultsEl: HTMLElement,
    matches: SearchRawEntry[],
    base: string,
    query: string,
  ) {
    resultsEl.innerHTML = "";

    if (!matches.length) {
      renderMessage(resultsEl, `no albums for “${query.trim()}”`);
      return;
    }

    const list = document.createElement("div");
    list.className = "header-search-list";

    for (const [index, entry] of matches.entries()) {
      const link = document.createElement("a");
      link.className = "header-search-result";
      link.dataset.searchResultIndex = String(index);
      link.href = `${base}blog/${entry.slug}`;

      const title = document.createElement("span");
      title.className = "header-search-result-title";
      title.textContent = getSearchResultPrimaryLabel(entry);
      link.appendChild(title);

      const secondary = getSearchResultSecondaryLabel(entry);
      if (secondary) {
        const meta = document.createElement("span");
        meta.className = "header-search-result-meta";
        meta.textContent = secondary;
        link.appendChild(meta);
      }

      list.appendChild(link);
    }

    resultsEl.appendChild(list);

    const fullSearch = document.createElement('a');
    fullSearch.className = 'header-search-full-link';
    fullSearch.href = `${base}search?q=${encodeURIComponent(query.trim())}`;
    fullSearch.textContent = 'open full search →';
    resultsEl.appendChild(fullSearch);
  }

  function bindHeaderSearch() {
    const root = document.getElementById("header-search") as
      | (HTMLElement & {
          __headerSearchBound?: boolean;
          __headerSearchReset?: () => void;
        })
      | null;
    if (!root || root.__headerSearchBound) return;

    const form = root.querySelector(
      ".header-search-form",
    ) as HTMLFormElement | null;
    const fieldEl = root.querySelector(
      ".header-search-field",
    ) as HTMLElement | null;
    const input = root.querySelector(
      ".header-search-input",
    ) as HTMLInputElement | null;
    const clearBtn = root.querySelector(
      ".header-search-clear",
    ) as HTMLButtonElement | null;
    const resultsEl = root.querySelector(
      ".header-search-results",
    ) as HTMLElement | null;
    const randomBtn = root.querySelector(
      ".header-search-random",
    ) as HTMLButtonElement | null;

    if (!form || !fieldEl || !input || !clearBtn || !resultsEl || !randomBtn) return;

    root.__headerSearchBound = true;

    const base = root.dataset.base || "/";
    let requestId = 0;
    let searchTimer: number | undefined;
    let selectedIndex = -1;

    const floatingSearchResults = createFloatingDropdown({
      getAnchor: () => fieldEl,
      getPanel: () => resultsEl,
      zIndex: 99999,
      position: {
        align: "start",
        width: (anchorRect) => Math.max(220, anchorRect.width),
        offset: 6,
        viewportPadding: 4,
        maxHeight: 352,
        minHeight: 120,
        flipThreshold: 160,
      },
      onOpenChange(open) {
        root.classList.toggle("is-open", open);
      },
    });

    function resetResults() {
      selectedIndex = -1;
      resultsEl.innerHTML = "";
      floatingSearchResults.close();
    }

    function moveSelection(direction: number) {
      const links = Array.from(
        resultsEl.querySelectorAll<HTMLAnchorElement>('[data-search-result-index]'),
      );
      if (!links.length) return;

      selectedIndex = (selectedIndex + direction + links.length) % links.length;
      links.forEach((link, index) => {
        link.setAttribute(
          'aria-selected',
          index === selectedIndex ? 'true' : 'false',
        );
      });
      links[selectedIndex].focus();
    }

    function cancelPendingSearch() {
      if (!searchTimer) return;
      window.clearTimeout(searchTimer);
      searchTimer = undefined;
    }

    function resetSearch() {
      requestId += 1;
      cancelPendingSearch();
      input.value = "";
      syncClearButton();
      resetResults();
    }

    function syncClearButton() {
      clearBtn.hidden = input.value.length === 0;
    }

    function getRecentSearches() {
      const value = localStorage.getItem('hellomraz-recent-searches');
      if (!value) return [];

      try {
        const recent = JSON.parse(value);
        if (!Array.isArray(recent)) return [];
        return recent.filter((item): item is string => typeof item === 'string');
      } catch {
        return [];
      }
    }

    function rememberSearch(query: string) {
      const recent = getRecentSearches();
      const next = [
        query,
        ...recent.filter((item) => item !== query),
      ].slice(0, 5);
      localStorage.setItem(
        'hellomraz-recent-searches',
        JSON.stringify(next),
      );
    }

    function renderRecentSearches() {
      const recent = getRecentSearches();
      if (!recent.length) return false;
      resultsEl.innerHTML = '';
      const heading = document.createElement('div');
      heading.className = 'header-search-message';
      heading.textContent = 'recent searches';
      resultsEl.appendChild(heading);
      const list = document.createElement('div');
      list.className = 'header-search-list';
      recent.forEach((query) => {
        const link = document.createElement('a');
        link.className = 'header-search-result';
        link.href = `${base}search?q=${encodeURIComponent(query)}`;
        link.textContent = query;
        list.appendChild(link);
      });
      resultsEl.appendChild(list);
      return true;
    }

    async function findMatches(query: string) {
      const trimmed = query.trim();
      if (!trimmed) return [];
      const entries = await loadSearchIndex(base);
      return searchEntries(entries, trimmed, 8) as PreparedSearchEntry[];
    }

    async function updateResults(query: string) {
      const currentRequest = ++requestId;
      const trimmed = query.trim();
      syncClearButton();

      if (!trimmed) {
        resetResults();
        return [] as PreparedSearchEntry[];
      }

      if (!cachedEntries) {
        renderMessage(resultsEl, "searching…", "loading");
        floatingSearchResults.open();
      }

      const matches = await findMatches(trimmed);
      if (currentRequest !== requestId) return [] as PreparedSearchEntry[];

      renderResults(resultsEl, matches, base, trimmed);
      floatingSearchResults.open();
      return matches;
    }

    function scheduleResultsUpdate() {
      cancelPendingSearch();
      searchTimer = window.setTimeout(() => {
        void updateResults(input.value);
      }, SEARCH_INPUT_DEBOUNCE_MS);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      cancelPendingSearch();
      const query = input.value.trim();
      const matches = await findMatches(query);
      const first = matches[0];
      if (query) rememberSearch(query);

      if (first) {
        navigateInternal(`${base}blog/${first.slug}`);
      } else if (query) {
        renderResults(resultsEl, [], base, query);
        floatingSearchResults.open();
      }
    });

    input.addEventListener("focus", () => {
      if (!cachedEntries) {
        void loadSearchIndex(base);
      }
      if (input.value.trim()) {
        void updateResults(input.value);
      } else if (renderRecentSearches()) {
        floatingSearchResults.open();
      }
    });

    input.addEventListener("input", () => {
      scheduleResultsUpdate();
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        moveSelection(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        moveSelection(-1);
      } else if (event.key === "Escape") {
        resetResults();
        input.blur();
      }
    });

    clearBtn.addEventListener("click", () => {
      resetSearch();
      input.focus();
    });

    randomBtn.addEventListener("click", async () => {
      randomBtn.disabled = true;

      try {
        const entries = await loadSearchIndex(base);
        const pick = pickRandomEntry(entries, {
          excludeSlug: getPostSlugFromPath(window.location.pathname, base),
        });
        if (pick) {
          resetSearch();
          navigateInternal(`${base}blog/${pick.slug}`);
        }
      } finally {
        randomBtn.disabled = false;
      }
    });

    root.__headerSearchReset = resetSearch;
    syncClearButton();
  }

  function handleHeaderSearchPageLoad() {
    bindHeaderSearch();

    const root = document.getElementById("header-search") as
      | (HTMLElement & {
          __headerSearchReset?: () => void;
        })
      | null;
    root?.__headerSearchReset?.();
  }

  document.addEventListener("astro:page-load", handleHeaderSearchPageLoad);
  bindHeaderSearch();
</script>

<style>
  .header-search {
    position: relative;
    z-index: 9999;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 18rem;
    min-width: min(100%, 14rem);
    max-width: 26rem;
  }
  .header-search-form {
    flex: 1;
    min-width: 0;
    margin: 0;
  }
  .header-search-random {
    flex: 0 0 auto;
    border-radius: 0.375rem;
    justify-content: center;
    padding: 0.5rem;
    min-width: 44px;
  }
  .header-search-random .dice-pip {
    fill: var(--theme-bg-elevated);
  }
  .header-search-random .dice-front {
    stroke: var(--theme-bg-elevated);
    stroke-width: 2;
  }
  .header-search-field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .header-search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--theme-text-muted);
    pointer-events: none;
    font-size: 0.875rem;
  }
  .header-search-input {
    width: 100%;
    min-height: 44px;
    padding: 0.625rem 2.5rem 0.625rem 2rem;
    border: 1px solid var(--theme-border);
    border-radius: 0.375rem;
    background: var(--theme-bg-elevated);
    color: var(--theme-text-primary);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.15s;
  }
  .header-search-input::placeholder {
    color: var(--theme-text-muted);
  }
  .header-search-input:hover,
  .header-search-input:focus,
  .header-search.is-open .header-search-input {
    border-color: var(--theme-accent);
  }
  .header-search-input:focus {
    box-shadow: 0 0 0 2px
      color-mix(in srgb, var(--theme-accent) 25%, transparent);
  }
  .header-search-clear {
    position: absolute;
    right: 0.375rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--theme-text-muted);
    cursor: pointer;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .header-search-clear:hover {
    color: var(--theme-text-primary);
    background: var(--theme-bg-hover);
  }
  .header-search-results {
    position: fixed;
    top: 0;
    left: 0;
    width: min(26rem, calc(100vw - 0.5rem));
    max-height: 22rem;
    overflow-y: auto;
    border: 1px solid var(--theme-border);
    border-radius: 0.5rem;
    background: var(--theme-bg-surface);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    z-index: 99999;
  }
  .header-search-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .header-search {
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>

<style is:global>
  .header-search-list {
    display: flex;
    flex-direction: column;
  }
  .header-search-result {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    padding: 0.75rem 0.875rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--theme-text-secondary);
    border-top: 1px solid var(--theme-border);
    transition:
      background 0.15s,
      color 0.15s;
  }
  .header-search-result:first-child {
    border-top: none;
  }
  .header-search-result:hover,
  .header-search-result:focus-visible,
  .header-search-result[aria-selected='true'] {
    background: var(--theme-bg-hover);
    color: var(--theme-text-primary);
    outline: none;
  }
  .header-search-full-link {
    display: block;
    padding: 0.75rem 0.875rem;
    border-top: 1px solid var(--theme-border);
    color: var(--theme-accent);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .header-search-full-link:hover,
  .header-search-full-link:focus-visible {
    background: var(--theme-bg-hover);
    outline: none;
  }
  .header-search-result-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: inherit;
  }
  .header-search-result-meta {
    display: block;
    font-size: 0.75rem;
    color: var(--theme-text-muted);
  }
  .header-search-message {
    display: block;
    padding: 0.875rem;
    font-size: 0.8125rem;
    color: var(--theme-text-muted);
  }
  .header-search-message.is-loading {
    color: var(--theme-text-secondary);
  }
</style>
