---
/**
 * GeoSearch — header picker that walks the geo hierarchy
 * (country → region → city) and opens a location's /geo listing.
 *
 * Reuses the tag picker panel look (src/styles/picker-dropdown.css).
 *
 * Props:
 *   base – site base path, e.g. "/" (from import.meta.env.BASE_URL)
 */
interface Props {
  base: string;
}

const { base } = Astro.props;
---

<div class="geo-search" data-base={base}>
  <button
    class="header-control-btn"
    type="button"
    data-geo-btn
    aria-expanded="false"
    aria-haspopup="listbox"
  >
    <span>#geo</span>
    <span class="header-control-arrow" data-geo-arrow>▾</span>
  </button>
</div>

<script>
  import '../styles/picker-dropdown.css';
  import type { GeoSearchEntry } from '../lib/geo';
  import { pickPlaceName } from '../lib/geo-i18n.mjs';
  import { bindOnce } from '../lib/page-bindings.mjs';
  import { getCurrentSiteLang, getSiteCopy } from '../lib/site-i18n.mjs';
  import {
    createPickerCrumbs,
    createPickerFooter,
    loadJsonCached,
    mountPicker,
    type PickerRowDescriptor,
  } from '../lib/picker-panel';

  type GeoEntry = GeoSearchEntry;

  interface GeoRoot extends HTMLElement {
    __geoPanel?: HTMLElement | null;
    /** Re-render of the current panel, used by the crumbs and the language switch. */
    __rerenderPanel?: () => void;
  }

  /** Countries shown at the root level. */
  const ROOT = '';

  const geoDataCache = new Map<string, Promise<GeoEntry[]>>();

  function loadPlaces(base: string) {
    return loadJsonCached(geoDataCache, `${base}api/geo.json`);
  }

  /** Localised name, used for ordering and rendering. */
  function placeName(place?: GeoEntry): string {
    return pickPlaceName(place?.names);
  }

  /** Biggest first, then alphabetical in the current language. */
  function byCountThenName(a: GeoEntry, b: GeoEntry) {
    return b.count - a.count || placeName(a).localeCompare(placeName(b));
  }

  function bindGeoSearch(root: GeoRoot) {
    const button = root.querySelector<HTMLButtonElement>('[data-geo-btn]');
    const arrow = root.querySelector<HTMLElement>('[data-geo-arrow]');
    if (!button || !arrow) return;

    const base = root.dataset.base || '/';
    // Drill-down stack: [] = countries, [country] = regions and cities, …
    let path: string[] = [];
    // Slug -> place, rebuilt from the loaded items on every render.
    let bySlug = new Map<string, GeoEntry>();
    let searchInput: HTMLInputElement | null = null;
    let footer: HTMLElement | null = null;

    function copy() {
      return getSiteCopy('geoPicker', getCurrentSiteLang());
    }

    // Direct children of a place: regions first, then region-less cities.
    function childrenOf(parentSlug: string): GeoEntry[] {
      const places = [...bySlug.values()];
      if (parentSlug === ROOT) {
        return places.filter((place) => place.type === 'country').sort(byCountThenName);
      }
      return places
        .filter(
          (place) =>
            place.regionSlug === parentSlug ||
            (place.countrySlug === parentSlug && !place.regionSlug),
        )
        .sort(byCountThenName);
    }

    function pathLabel(): string[] {
      return path.map((slug) => placeName(bySlug.get(slug)) || slug);
    }

    // Full location path for a search hit, for example "Germany / Bavaria".
    function trailFor(place: GeoEntry): string {
      const parts = [placeName(bySlug.get(place.countrySlug)) || place.country];
      if (place.regionSlug) parts.push(placeName(bySlug.get(place.regionSlug)));
      // City-states repeat their own name as country and region.
      const unique = parts.filter((part, index) => part && parts.indexOf(part) === index);
      return unique.join(' / ');
    }

    // Countries and regions always drill. A city row opens its listing.
    function canDrill(place: GeoEntry): boolean {
      return place.type !== 'city';
    }

    // Clear the query and re-render. Used by the crumbs and Backspace.
    function resetSearch() {
      if (!searchInput) return;
      searchInput.value = '';
      searchInput.dispatchEvent(new Event('input'));
    }

    const crumbs = createPickerCrumbs(
      () => copy().rootLabel,
      (depth) => {
        path = path.slice(0, depth);
        resetSearch();
      },
    );

    mountPicker<GeoEntry>({
      root,
      button,
      arrow,
      panelKey: '__geoPanel',
      refreshKey: '__rerenderPanel',
      crumbs,
      searchPlaceholder: () => copy().placeholder,
      emptyText: () => copy().empty,
      load: (baseUrl) => loadPlaces(baseUrl),
      buildFooter(ctx) {
        searchInput = ctx.searchInput;
        footer = createPickerFooter(`${base}map`, copy().footer, ctx.close);
        searchInput.addEventListener('keydown', (event) => {
          if (event.key !== 'Backspace' || !searchInput?.value || !path.length) return;
          event.preventDefault();
          path = path.slice(0, -1);
          resetSearch();
        });
        return footer;
      },
      buildRows(items, query) {
        bySlug = new Map(items.map((place) => [place.slug, place]));
        if (footer) footer.textContent = copy().footer;

        if (query) {
          // Search ignores the current level and matches every place by name,
          // country, or region.
          const normalized = query.toLowerCase().trim();
          const typeOrder: Record<string, number> = { country: 0, state: 1, city: 2 };
          const matches = items
            .filter((place) => {
              const haystack = [
                place.names.en,
                place.names.ru,
                place.names.de,
                place.country,
                placeName(bySlug.get(place.countrySlug)),
                placeName(bySlug.get(place.regionSlug)),
              ];
              return haystack.some((value) => (value ?? '').toLowerCase().includes(normalized));
            })
            .sort(
              (a, b) =>
                byCountThenName(a, b) ||
                (typeOrder[a.type] ?? 9) - (typeOrder[b.type] ?? 9) ||
                placeName(a).localeCompare(placeName(b)),
            );
          crumbs.setTrail([]);
          return matches.map((place) => ({
            href: `${base}geo/${encodeURIComponent(place.slug)}`,
            name: placeName(place),
            meta: place.type === 'country' ? 'country' : trailFor(place),
            count: place.count,
            drill: canDrill(place),
            value: place.slug,
          }));
        }

        crumbs.setTrail(pathLabel());
        const parent = path[path.length - 1] ?? ROOT;
        const children = childrenOf(parent);
        const descriptors: PickerRowDescriptor[] = children.map((place) => ({
          href: `${base}geo/${encodeURIComponent(place.slug)}`,
          name: placeName(place),
          meta: '',
          count: place.count,
          drill: canDrill(place),
          value: place.slug,
        }));

        // Nothing nested here, for example a country tagged at country level:
        // offer its listing so the click still leads somewhere.
        if (!children.length) {
          const place = bySlug.get(parent);
          if (place) {
            descriptors.push({
              href: `${base}geo/${encodeURIComponent(parent)}`,
              name: 'open listing',
              variant: 'listing',
            });
          }
        }
        return descriptors;
      },
      onDrill(value) {
        path = [...path, String(value)];
      },
    });
  }

  function initGeoSearch() {
    document.querySelectorAll<GeoRoot>('.geo-search').forEach((root) => {
      bindGeoSearch(root);
    });
  }

  bindOnce('geosearch:init', () => {
    document.addEventListener('astro:page-load', initGeoSearch);
  });
  initGeoSearch();
</script>
