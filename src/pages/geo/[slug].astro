---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCoverThumb } from '../../lib/albums';
import { getDateIndex } from '../../lib/blog-data.mjs';
import {
  getAlbumsForGeo,
  getGeo,
  getGeoAncestors,
  getAllGeoSugs,
  getPlaceLabel,
  placeNameAttr,
} from '../../lib/geo';
import type { GeoPlace } from '../../lib/geo';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

export async function getStaticPaths() {
  const slugs = getAllGeoSugs();
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props as Props;
const place = getGeo(slug);
const dateIndex = await getDateIndex();
const albumPosts = getAlbumsForGeo(slug);
const albumSlugs = new Set(albumPosts.map((post) => post.slug));

const { getPublishedPosts } = await import('../../lib/blog-data.mjs');
const published = await getPublishedPosts();
const posts = published
  .filter((post) => albumSlugs.has(post.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const ancestors = getGeoAncestors(slug);
interface Crumb {
  slug: string;
  name: string;
  place?: GeoPlace;
}
const crumbs: Crumb[] = ancestors.map((crumbSlug) => {
  const crumbPlace = getGeo(crumbSlug);
  return {
    slug: crumbSlug,
    name: crumbPlace?.name ?? crumbSlug,
    place: crumbPlace,
  };
});
crumbs.push({ slug, name: place?.name ?? slug, place });

const title = place?.name ?? slug;
const placeLabel = getPlaceLabel(place);
const kind = place?.type ?? 'location';
---

<script>
  import { getCurrentSiteLang, getSiteCopy } from '../../lib/site-i18n.mjs';

  /** Kind and review count of this location, in the visitor's language. */
  function renderGeoMeta() {
    const meta = document.querySelector<HTMLElement>('[data-geo-meta]');
    if (meta) {
      const lang = getCurrentSiteLang();
      const copy = getSiteCopy('geoPage', lang);
      const kind = meta.dataset.geoKind ?? 'location';
      const count = Number(meta.dataset.geoCount ?? 0);
      const noun = copy.posts[new Intl.PluralRules(lang).select(count)] ?? copy.posts.other;
      const label = copy[kind] ?? copy.location;
      meta.textContent = count ? `${label} · ${count} ${noun}` : label;
    }

    const empty = document.querySelector<HTMLElement>('[data-geo-empty]');
    if (empty) empty.textContent = getSiteCopy('geoPage', getCurrentSiteLang()).empty;
  }

  window.addEventListener('lang-changed', renderGeoMeta);
  document.addEventListener('astro:page-load', renderGeoMeta);
  renderGeoMeta();
</script>

<Layout title={title}>
  <div class="min-h-full theme-surface">
    <PageHeader dateIndex={dateIndex} />

    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <div class="mb-6">
        {crumbs.length > 1 ? (
          <nav class="geo-breadcrumb text-xs mb-3" aria-label="Geo path">
            {crumbs.map((crumb, index) => (
              <span class="geo-breadcrumb__item">
                {index > 0 && <span class="geo-breadcrumb__sep">/</span>}
                {index === crumbs.length - 1 ? (
                  <span class="theme-text-secondary" data-geo-names={placeNameAttr(crumb.place)}
                    >{crumb.name}</span
                  >
                ) : (
                  <a
                    href={`${base}geo/${crumb.slug}`}
                    class="theme-text-accent"
                    data-geo-names={placeNameAttr(crumb.place)}>{crumb.name}</a
                  >
                )}
              </span>
            ))}
          </nav>
        ) : (
          <a href={`${base}map`} class="text-xs mb-3 inline-block theme-text-accent">
            ← map /
          </a>
        )}

        <h1
          class="text-2xl font-bold theme-text-primary"
          data-geo-names={placeNameAttr(place)}
        >
          {placeLabel}
        </h1>
        <p
          class="text-sm mt-1 theme-text-muted"
          data-geo-meta
          data-geo-kind={kind}
          data-geo-count={posts.length}
        >
          {kind} · {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        </p>
        {posts.length === 0 && (
          <p class="text-xs mt-3 theme-text-muted" data-geo-empty>
            no reviews from here yet — the first one lights this place up on the map
          </p>
        )}
      </div>

      <div class="space-y-0">
        {posts.map((post) => (
          <a href={`${base}blog/${post.id}`} class="tag-post-row">
            {getCoverThumb(post.id, 'sm') ? (
              <img
                src={getCoverThumb(post.id, 'sm')}
                alt={post.data.title}
                width="72"
                height="72"
                loading="lazy"
                decoding="async"
                class="tag-post-cover"
              />
            ) : (
              <span class="tag-post-cover-placeholder" aria-hidden="true">
                {post.data.title.slice(0, 1)}
              </span>
            )}
            <span class="tag-post-info">
              <span class="tag-post-title theme-text-primary">{post.data.title}</span>
              <span class="tag-post-date theme-text-muted">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .tag-post-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 88px;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--theme-border);
    color: var(--theme-text-secondary);
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .tag-post-row:hover {
    color: var(--theme-text-primary);
    background-color: var(--theme-bg-hover);
  }
  .tag-post-cover,
  .tag-post-cover-placeholder {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border: 1px solid var(--theme-border);
  }
  .tag-post-cover {
    display: block;
    object-fit: cover;
  }
  .tag-post-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--theme-bg-elevated), var(--theme-bg-hover));
    color: var(--theme-accent);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .tag-post-info {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.375rem;
  }
  .tag-post-date {
    flex-shrink: 0;
    color: var(--theme-text-muted);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
  }
  .tag-post-title {
    min-width: 0;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .tag-post-row {
      gap: 0.75rem;
      min-height: 72px;
      padding: 0.625rem 0;
    }
    .tag-post-cover,
    .tag-post-cover-placeholder {
      flex-basis: 56px;
      width: 56px;
      height: 56px;
    }
    .tag-post-title {
      display: -webkit-box;
      white-space: normal;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
  .geo-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  .geo-breadcrumb__sep {
    color: var(--theme-text-muted);
    margin: 0 0.15rem;
  }
  .geo-breadcrumb__item {
    display: inline-flex;
    align-items: center;
  }
</style>
