---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StreamingPlayer from '../../components/StreamingPlayer.astro';
import AlbumMeta from '../../components/AlbumMeta.astro';
import ListenOn from '../../components/ListenOn.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getPostColor } from '../../lib/colors';
import { getBandcampData } from '../../lib/bandcamp';
import { getStreamingLinks } from '../../lib/streaming';
import { getAlbum, getCoverThumb, parseArtistAlbum } from '../../lib/albums';
import {
  getDateIndex,
  getLinkedTagNames,
  getPublishedPosts,
} from '../../lib/blog-data.mjs';
import { encodeTagParam } from '../../lib/tag-path';
import '../../layouts/styles/markdown.css';

export async function getStaticPaths() {
  const [posts, linkedTagNames] = await Promise.all([
    getPublishedPosts(),
    getLinkedTagNames(),
  ]);

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      linkedTagNames,
      previousPost: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  linkedTagNames: string[];
  previousPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const {
  post,
  linkedTagNames = [],
  previousPost,
  nextPost,
} = Astro.props as Props;
const slug = post.id;
const postTitle = post.data.title;
const postTags = post.data.tags ?? [];
const linkedTags = new Set(linkedTagNames);
const { Content } = await render(post);
const color = getPostColor(slug);
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const dateIndex = await getDateIndex();

const initials = postTitle
  .split(/[\s\-–—]+/)
  .slice(0, 2)
  .map((word: string) => word[0]?.toUpperCase() ?? '')
  .join('');

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const bc = getBandcampData(slug);
const bcAlbumId = bc?.albumId;
const bcUrl = bc?.url;
const bcCover = bc?.coverUrl;
const playerCover = getCoverThumb(slug, 'md') ?? bcCover;

const albumEntry = getAlbum(slug);
const albumTags = albumEntry?.bcTags;
const parsed = parseArtistAlbum(postTitle);
const albumArtist = albumEntry?.artist || parsed?.artist;
const albumName = albumEntry?.album || parsed?.album;

const streamingLinks = getStreamingLinks(slug);
const hasLongTitle = postTitle.length > 40;
const hasStreamingLinks = streamingLinks.length > 0;
const displayTags = albumTags ?? postTags;
const contentClassList = ['post-page-content'];

if (hasStreamingLinks) {
  contentClassList.push('post-page-content-with-player');
}

let primaryLink:
  | {
      service: string;
      url: string;
    }
  | undefined;

if (!bcUrl && hasStreamingLinks) {
  primaryLink = {
    service: streamingLinks[0].service,
    url: streamingLinks[0].url,
  };
}

let ogImage: string | undefined;
if (bcCover) {
  ogImage = bcCover.includes('bcbits.com')
    ? bcCover.replace(/_5\.jpg$/, '_2.jpg')
    : bcCover;
}

const postDescription = post.data.description || `${postTitle} — music review on poeba.lu`;
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
const lightboxCover = bcCover?.replace(/_5\.jpg$/, '_2.jpg') ?? bcCover;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: postTitle,
  description: postDescription,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: 'hellomraz' },
  image: lightboxCover ? [lightboxCover] : undefined,
  keywords: postTags,
  mainEntity: {
    '@type': 'MusicAlbum',
    name: albumName || postTitle,
    byArtist: albumArtist ? { '@type': 'MusicGroup', name: albumArtist } : undefined,
  },
};
---

<Layout title={postTitle} description={postDescription} image={ogImage} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <div
    class="post-page relative min-h-full flex flex-col overflow-x-hidden rounded-lg theme-surface"
    transition:name={`post-${slug}-box`}
    data-post-slug={slug}
  >
    <PageHeader dateIndex={dateIndex} />

    <!-- Header: cover art + metadata -->
    <div
      class="post-page-hero flex flex-col items-center md:flex-row gap-6 px-4 sm:px-6 pt-6 pb-6"
    >
      <!-- Cover art -->
      {
        bcCover ? (
          <button
            type="button"
            class="post-cover-trigger flex-none"
            data-cover-lightbox-open
            aria-label={`Enlarge cover for ${postTitle}`}
          >
            <img
              src={bcCover}
              alt={postTitle}
              class="w-48 sm:w-56 md:w-72 h-auto rounded-md object-contain bg-[var(--theme-bg-elevated)] shadow-2xl"
              transition:name={`post-${slug}-image`}
            />
          </button>
        ) : (
          <div
            class="post-cover-placeholder h-36 w-36 sm:h-44 sm:w-44 md:h-52 md:w-52 flex-none rounded-md flex items-center justify-center text-5xl font-bold text-white shadow-2xl"
            transition:name={`post-${slug}-image`}
          >
            {initials}
          </div>
        )
      }

      <!-- Metadata -->
      <div class="flex flex-col gap-2 text-center md:text-left">
        <span class="text-xs font-semibold uppercase tracking-wider theme-text-secondary">Review</span>
        <h1
          class:list={['title-clamp font-extrabold leading-none theme-text-primary', { 'title-clamp-long': hasLongTitle }]}
          transition:name={`post-${slug}-title`}
        >
          {postTitle}
        </h1>
        <div class="post-tag-list flex flex-wrap gap-x-1 gap-y-1 mt-1 theme-text-secondary">
          {
            postTags.map((tag, index) => {
              const isLinkedTag = linkedTags.has(tag);

              return (
                <span>
                  {isLinkedTag ? (
                    <a href={`${base}tags/${encodeTagParam(tag)}`} class="post-tag-link hover:underline inline-block">{tag}</a>
                  ) : (
                    <span class="post-tag-text inline-block">{tag}</span>
                  )}
                  {index < postTags.length - 1 && <span class="post-tag-separator">|</span>}
                </span>
              );
            })
          }
        </div>
        <div class="text-xs theme-text-muted">
          {formattedDate} · {readingMinutes} min read
        </div>
      </div>
    </div>

    <!-- Player + Content side by side -->
    <div class="post-page-body">
      <!-- Streaming player (left) -->
      {
        hasStreamingLinks && (
          <div class="post-page-player-slot">
            <StreamingPlayer
              links={streamingLinks}
              bandcampAlbumId={bcAlbumId}
              coverUrl={playerCover}
              slug={slug}
              title={postTitle}
            />
          </div>
        )
      }

      <!-- Content area (right) -->
      <div
        class:list={contentClassList}
      >
        <div class="post-review-copy markdown-content leading-relaxed theme-text-secondary">
          <Content />
        </div>

        {/* Album metadata, streaming links, and related posts */}
        <AlbumMeta
          artist={albumArtist}
          album={albumName}
          tags={displayTags}
          date={post.data.pubDate}
          releaseDate={albumEntry?.releaseDate}
          bandcampUrl={bcUrl ?? undefined}
          primaryLink={primaryLink}
          linkedTags={linkedTags}
        />

        <ListenOn links={streamingLinks} />

        <RelatedPosts
          currentSlug={slug}
          tags={postTags}
        />
      </div>
    </div>

    {(previousPost || nextPost) && (
      <nav class="post-prev-next" aria-label="Review navigation">
        {previousPost ? (
          <a href={`${base}blog/${previousPost.id}`} class="post-prev-next-link post-prev-next-link-previous">
            <span class="post-prev-next-label">← previous review</span>
            <span>{previousPost.data.title}</span>
          </a>
        ) : <span />}
        {nextPost ? (
          <a href={`${base}blog/${nextPost.id}`} class="post-prev-next-link post-prev-next-link-next">
            <span class="post-prev-next-label">next review →</span>
            <span>{nextPost.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}

    <!-- Background gradient (context color) -->
    <div class="post-context-backdrop absolute top-0 inset-x-0 h-80 z-[-1]">
      <div
        class="post-context-glow el-to-fade transition-all duration-500 absolute inset-0 scale-90 opacity-30 blur-2xl"
      >
      </div>
    </div>
  </div>

  {lightboxCover && (
    <dialog class="cover-lightbox" data-cover-lightbox>
      <button type="button" class="cover-lightbox-close" data-cover-lightbox-close aria-label="Close cover">✕</button>
      <img src={lightboxCover} alt={postTitle} width="1400" height="1400" loading="lazy" />
    </dialog>
  )}
</Layout>

<style define:vars={{
  postCoverGradientStart: `${color.accent}cc`,
  postCoverGradientEnd: color.dark,
  postContextGradient: `${color.dark}cc`,
  postContextGlow: `${color.accent}55`,
}}>
  .title-clamp {
    font-size: clamp(1.5rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .title-clamp-long {
    font-size: clamp(1.375rem, 3.25vw, 2.5rem);
  }
  .post-tag-link,
  .post-tag-text {
    padding: 4px 0;
    min-height: 44px;
    line-height: 2;
  }
  @media (min-width: 768px) {
    .post-tag-link,
    .post-tag-text {
      min-height: 0;
      padding: 2px 0;
      line-height: 1.7;
    }
  }
  @media (max-width: 767px) {
    /* pipes orphan at wrapped line ends on narrow screens */
    .post-tag-separator {
      display: none;
    }
    .post-tag-list {
      gap: 0.375rem 0.5rem;
    }
  }
  .post-tag-link {
    color: var(--theme-text-secondary);
    text-decoration: none;
  }
  .post-tag-text,
  .post-tag-separator {
    color: var(--theme-text-muted);
  }
  .post-page-hero {
    width: min(100%, 70rem);
    margin-inline: auto;
  }
  .post-page-body {
    display: grid;
    grid-template-columns: minmax(26rem, 34rem) minmax(0, 1fr);
    justify-content: center;
    gap: 2rem;
    width: min(100%, 70rem);
    margin-inline: auto;
    padding: 2.25rem 1rem 3rem;
  }
  /* Date jump widgets are noisy on single post pages */
  .post-page :global(.date-selector) {
    display: none;
  }
  .post-page-player-slot,
  .post-page-content {
    min-width: 0;
  }
  .post-page-content {
    background-color: color-mix(in srgb, var(--theme-bg-surface) 60%, transparent);
  }
  .post-page-content-with-player {
    border-left: 1px solid color-mix(in srgb, var(--theme-text-muted) 20%, transparent);
    padding-left: 1.5rem;
  }
  .post-review-copy {
    max-width: 68ch;
  }
  @media (max-width: 767px) {
    .post-page-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.25rem 1rem 2.5rem;
    }
    .post-page-content-with-player {
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--theme-text-muted) 20%, transparent);
      padding-top: 1.25rem;
      padding-left: 0;
    }
  }
  .post-cover-trigger {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .post-cover-trigger:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 4px;
  }
  .post-prev-next {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    width: min(100%, 70rem);
    margin: 0 auto;
    padding: 0 1rem 2rem;
  }
  .post-prev-next-link {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--theme-border);
    color: var(--theme-text-primary);
    text-decoration: none;
  }
  .post-prev-next-link:hover,
  .post-prev-next-link:focus-visible {
    border-color: var(--theme-accent);
    color: var(--theme-accent);
    outline: none;
  }
  .post-prev-next-link-next {
    align-items: flex-end;
    text-align: right;
  }
  .post-prev-next-label {
    color: var(--theme-text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .cover-lightbox {
    width: min(90vw, 52rem);
    max-width: none;
    padding: 3rem 1rem 1rem;
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-surface);
  }
  .cover-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.78);
  }
  .cover-lightbox img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cover-lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-elevated);
    color: var(--theme-text-primary);
    cursor: pointer;
  }
  .cover-lightbox-close:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 3px;
  }
  .post-cover-placeholder {
    background: linear-gradient(
      135deg,
      var(--postCoverGradientStart),
      var(--postCoverGradientEnd)
    );
  }
  .post-context-backdrop {
    background: linear-gradient(to bottom, var(--postContextGradient), transparent);
  }
  .post-context-glow {
    background: radial-gradient(
      ellipse at 30% 0%,
      var(--postContextGlow),
      transparent 70%
    );
  }
  @media (max-width: 640px) {
    .post-prev-next {
      grid-template-columns: 1fr;
    }
    .post-prev-next-link-next {
      align-items: flex-start;
      text-align: left;
    }
  }
  /* Override markdown-content link colors */
  .markdown-content a {
    color: var(--theme-accent) !important;
  }
  .markdown-content a:hover {
    color: var(--theme-accent-hover) !important;
    border-bottom-color: var(--theme-accent-hover) !important;
  }
</style>

<script>
  function initCoverLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-cover-lightbox]');
    const openButton = document.querySelector<HTMLButtonElement>('[data-cover-lightbox-open]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-cover-lightbox-close]');
    if (!dialog || !openButton || !closeButton || openButton.dataset.lightboxBound === '1') return;

    openButton.dataset.lightboxBound = '1';
    openButton.addEventListener('click', () => dialog.showModal());
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  document.addEventListener('astro:page-load', initCoverLightbox);
  initCoverLightbox();
</script>
