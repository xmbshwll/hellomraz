---
import { ClientRouter } from 'astro:transitions';
import './layout.css';
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/fonts.css';
import SideMenu from '../components/Side/SideMenu.astro';
import FloatingPlayerDock from '../components/FloatingPlayerDock.astro';
import { getPublishedPostCount, getRecentPosts } from '../lib/blog-data.mjs';
import { SIDEBAR_INITIAL_POSTS } from '../lib/feed-limits.mjs';
import { themeStylesheetUrls } from '../lib/theme-files.mjs';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const { title = 'poeba.lu', description = 'music reviews', image, type = 'website' } = Astro.props;

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://poeba.lu';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const rssFeedUrl = new URL(`${base}rss.xml`, siteUrl).toString();
const ogImage = image || `${siteUrl}${base}og-default.png`;
const fullTitle = `${title} | poeba.lu`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}${base}search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const [recentPosts, totalPosts] = await Promise.all([
  getRecentPosts(SIDEBAR_INITIAL_POSTS),
  getPublishedPostCount(),
]);
const hasMoreRecentPosts = totalPosts > SIDEBAR_INITIAL_POSTS;
const lightThemeIds = ['light', 'nord-light', 'catppuccin-latte', 'rose-pine-dawn'];
const themeStylesheetMap = themeStylesheetUrls(base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="application-name" content={SITE_TITLE} />
    <meta name="theme-color" content="#2E3440" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} RSS Feed`}
      href={rssFeedUrl}
    />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <title>{fullTitle}</title>
    <meta name="base-url" content={base} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="poeba.lu" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Telegram -->
    <meta name="telegram:channel" content="@hellomraz" />
    <link rel="preconnect" href="https://f4.bcbits.com" crossorigin />
    <link rel="dns-prefetch" href="https://f4.bcbits.com" />
    <ClientRouter fallback="swap" />
    <!-- Apply saved theme before first paint to prevent flash -->
    <link id="theme-css" rel="stylesheet" />
    <script is:inline define:vars={{ lightThemeIds, themeStylesheetMap }}>
      (function () {
        var lightThemes = new Set(lightThemeIds || []);
        var stylesheetUrls = themeStylesheetMap || {};

        function applyStylesheet(theme) {
          var themeLink = document.getElementById('theme-css');
          if (!themeLink) return;
          var href = stylesheetUrls[theme];
          if (href) {
            themeLink.setAttribute('href', href);
          } else {
            themeLink.removeAttribute('href');
          }
        }

        window.__hellomrazApplyTheme = function (nextTheme) {
          var theme = nextTheme || localStorage.getItem('color-theme') || 'dark';
          var html = document.documentElement;
          html.setAttribute('data-theme', theme);
          if (lightThemes.has(theme)) {
            html.classList.remove('dark');
          } else {
            html.classList.add('dark');
          }
          applyStylesheet(theme);
        };

        document.documentElement.classList.add('no-transition');
        window.__hellomrazApplyTheme();
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove('no-transition');
          });
        });
      })();
    </script>
    <!-- Place labels follow the language switcher. -->
    <script>
      import { initPlaceNameSwitching } from '../lib/geo-i18n.mjs';

      initPlaceNameSwitching();
    </script>

    <!-- Analytics loads after first interaction or idle time in production. -->
    <script>
      if (import.meta.env.PROD) {
        let analyticsLoaded = false;
        const loadAnalytics = () => {
          if (analyticsLoaded) return;
          analyticsLoaded = true;
          const script = document.createElement('script');
          script.defer = true;
          script.src = 'https://cloud.umami.is/script.js';
          script.dataset.websiteId = 'c50bec21-a36c-4762-92ce-7335a35a4060';
          document.head.appendChild(script);
        };
        const scheduleAnalytics = () => loadAnalytics();
        window.addEventListener('scroll', scheduleAnalytics, { once: true, passive: true });
        window.addEventListener('pointerdown', scheduleAnalytics, { once: true, passive: true });
        window.addEventListener('keydown', scheduleAnalytics, { once: true });
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadAnalytics, { timeout: 5000 });
        } else {
          window.setTimeout(loadAnalytics, 5000);
        }
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="app-shell flex items-stretch theme-base">
      <!-- Mobile sidebar overlay -->
      <div id="mobile-sidebar-overlay" class="mobile-sidebar-overlay" aria-hidden="true">
        <div class="mobile-sidebar-backdrop"></div>
        <div class="mobile-sidebar-panel" role="dialog" aria-modal="true" aria-label="Site menu">
          <div class="mobile-sidebar-header">
            <button id="mobile-sidebar-close" class="mobile-sidebar-close" aria-label="Close menu">
              ✕
            </button>
          </div>
          <div class="mobile-sidebar-content">
            <SideMenu initialPosts={recentPosts} hasMore={hasMoreRecentPosts} />
          </div>
        </div>
      </div>

      <!-- Sidebar — hidden on small screens -->
      <div
        class="w-[280px] flex-col hidden lg:flex overflow-y-auto flex-shrink-0 border-r theme-border"
        transition:persist="sidebar"
      >
        <SideMenu initialPosts={recentPosts} hasMore={hasMoreRecentPosts} />
      </div>
      <!-- Main content -->
      <main id="main-content" class="app-main flex-1 min-w-0 theme-surface" tabindex="-1">
        <slot />
      </main>
    </div>

    <FloatingPlayerDock />

    <!-- View-transitions support warning -->
    <div
      id="not-support"
      class="fixed hidden bg-amber-700 bottom-0 inset-x-0 rounded-t-md text-center py-2 z-50 font-semibold text-sm"
    >
      Your browser doesn't support View Transitions yet — try Chrome or Edge.
    </div>

    <script>
      import { navigate } from 'astro:transitions/client';
      import { applyThemeStylesheet } from '../lib/theme-files.mjs';

      type LayoutWindow = Window & {
        __hellomrazApplyTheme?: (theme?: string | null) => void;
        __hellomrazNavigate?: (href: string) => Promise<void> | void;
        __themePersistenceBound?: boolean;
      };

      const layoutWindow = window as LayoutWindow;

      function applySavedTheme() {
        const applyTheme = layoutWindow.__hellomrazApplyTheme;
        if (typeof applyTheme === 'function') {
          applyTheme();
          return;
        }

        const fallbackTheme = localStorage.getItem('color-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', fallbackTheme);
        applyThemeStylesheet(fallbackTheme);
      }

      if (!layoutWindow.__hellomrazNavigate) {
        layoutWindow.__hellomrazNavigate = async (href: string) => {
          if (!href) return;

          try {
            await navigate(href);
          } catch {
            window.location.assign(href);
          }
        };
      }

      if (!layoutWindow.__themePersistenceBound) {
        layoutWindow.__themePersistenceBound = true;
        document.addEventListener('astro:after-swap', applySavedTheme);
        document.addEventListener('astro:page-load', applySavedTheme);
      }

      applySavedTheme();
    </script>

    <script>
      interface BeforeInstallPromptEvent extends Event {
        prompt(): Promise<void>;
        userChoice: Promise<{
          outcome: 'accepted' | 'dismissed';
          platform: string;
        }>;
      }

      type PwaWindow = Window & {
        __deferredPwaPrompt?: BeforeInstallPromptEvent | null;
        __pwaBound?: boolean;
      };

      const pwaWindow = window as PwaWindow;

      if (!pwaWindow.__pwaBound) {
        pwaWindow.__pwaBound = true;

        window.addEventListener('beforeinstallprompt', (event) => {
          event.preventDefault();
          pwaWindow.__deferredPwaPrompt = event as BeforeInstallPromptEvent;
          window.dispatchEvent(new CustomEvent('pwa-install-available'));
        });

        window.addEventListener('appinstalled', () => {
          pwaWindow.__deferredPwaPrompt = null;
          window.dispatchEvent(new CustomEvent('pwa-installed'));
        });

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            const baseUrl =
              document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/';

            navigator.serviceWorker
              .register(`${baseUrl}sw.js`, { scope: baseUrl })
              .catch(() => undefined);
          });
        }
      }
    </script>

    <script>
      type LayoutUiWindow = Window & {
        __layoutUiBound?: boolean;
      };

      function revealFadeTargets() {
        for (const el of document.querySelectorAll('.el-to-fade')) {
          el.classList.remove('scale-90');
        }
      }

      if (!document.startViewTransition) {
        const el = document.getElementById('not-support');
        if (el) el.classList.remove('hidden');
      }

      if (!(window as LayoutUiWindow).__layoutUiBound) {
        (window as LayoutUiWindow).__layoutUiBound = true;
        document.addEventListener('astro:page-load', revealFadeTargets);
      }

      revealFadeTargets();
    </script>

    <!-- Mobile sidebar toggle -->
    <script>
      type MobileSidebarWindow = Window & {
        __mobileSidebarKeydownBound?: boolean;
        __mobileSidebarInitBound?: boolean;
        __mobileSidebarReturnFocus?: HTMLElement | null;
      };

      const mobileSidebarWindow = window as MobileSidebarWindow;

      function closeMobileSidebar() {
        const overlay = document.getElementById('mobile-sidebar-overlay');
        if (!overlay) return;

        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('mobile-sidebar-open');
        mobileSidebarWindow.__mobileSidebarReturnFocus?.focus();
        mobileSidebarWindow.__mobileSidebarReturnFocus = null;
      }

      function initMobileSidebar() {
        const overlay = document.getElementById('mobile-sidebar-overlay');
        if (!overlay) return;

        function open() {
          mobileSidebarWindow.__mobileSidebarReturnFocus =
            document.activeElement as HTMLElement | null;
          overlay.classList.add('open');
          overlay.setAttribute('aria-hidden', 'false');
          document.body.classList.add('mobile-sidebar-open');
          overlay.querySelector<HTMLElement>('#mobile-sidebar-close')?.focus();
        }

        // Always re-bind: the button may be persisted but overlay is fresh
        const openBtn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('mobile-sidebar-close');
        const backdrop = overlay.querySelector('.mobile-sidebar-backdrop');

        if (openBtn) {
          openBtn.onclick = open;
        }
        if (closeBtn) closeBtn.onclick = closeMobileSidebar;
        if (backdrop) (backdrop as HTMLElement).onclick = closeMobileSidebar;

        if (!(window as MobileSidebarWindow).__mobileSidebarKeydownBound) {
          mobileSidebarWindow.__mobileSidebarKeydownBound = true;
          document.addEventListener('keydown', (event) => {
            const currentOverlay = document.getElementById('mobile-sidebar-overlay');
            if (!currentOverlay?.classList.contains('open')) return;

            if (event.key === 'Escape') {
              closeMobileSidebar();
              return;
            }

            if (event.key !== 'Tab') return;
            const focusable = Array.from(
              currentOverlay.querySelectorAll<HTMLElement>(
                'button, a, input, select, [tabindex]:not([tabindex="-1"])',
              ),
            ).filter((element) => !element.hasAttribute('disabled'));
            if (!focusable.length) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          });
        }

        // Close on navigation (view transitions)
        closeMobileSidebar();
      }

      if (!(window as MobileSidebarWindow).__mobileSidebarInitBound) {
        (window as MobileSidebarWindow).__mobileSidebarInitBound = true;
        document.addEventListener('astro:page-load', initMobileSidebar);
      }
      initMobileSidebar();
    </script>
  </body>
</html>
